# RetinAI Backend — Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit .env to Git

# ── App ────────────────────────────────────────────────────
ENVIRONMENT=development           # development | production
DEBUG=true

# ── Auth ───────────────────────────────────────────────────
JWT_SECRET=change-this-to-a-long-random-secret-key
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440           # 24 hours

# ── Database ───────────────────────────────────────────────
# Dev: leave empty → uses SQLite (retinai.db auto-created)
# Prod: paste Supabase connection string
DATABASE_URL=

# ── Cloudinary (Image Storage) ─────────────────────────────
# Get from: cloudinary.com → Dashboard → API Keys
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Model ──────────────────────────────────────────────────
MODEL_PATH=models/best_dr_model.pth
MODEL_INPUT_SIZE=380

# ── CORS ───────────────────────────────────────────────────
# Dev: allow all. Prod: set to exact Vercel URL
CORS_ORIGINS=http://localhost:3000

# ── Rate Limiting ──────────────────────────────────────────
RATE_LIMIT=100/minute

# JWT Auth
JWT_SECRET_KEY=change-this-in-production-use-openssl-rand-hex-32
JWT_EXPIRE_MINUTES=480
